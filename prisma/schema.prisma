// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Admin {
  id              Int       @id @default(autoincrement())
  email           String    @unique
  name            String?
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedBookings Booking[]
  bills           Bill[]
  expenses        Expense[]

  @@map("admins")
}

model Booking {
  id             String       @id // e.g. CC-4921
  customerName   String       @map("customer_name")
  customerPhone  String       @map("customer_phone")
  customerEmail  String       @map("customer_email")
  bookingDate    String       @map("booking_date") // YYYY-MM-DD
  startTime      String       @map("start_time")
  endTime        String       @map("end_time")
  durationMins   Int          @map("duration_mins")
  controllers    Int
  totalPrice     Int          @map("total_price")
  status         String       @default("confirmed") // confirmed, cancelled, checked_in
  paymentStatus  String       @default("pending") @map("payment_status") // paid, pending
  podId          String       @default("pod-01") @map("pod_id")
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @default(now()) @map("updated_at")
  updatedByEmail String?      @map("updated_by")
  updatedBy      Admin?       @relation(fields: [updatedByEmail], references: [email], onDelete: SetNull)
  slots          BookedSlot[]

  @@map("bookings")
}

model BookedSlot {
  id          Int      @id @default(autoincrement())
  bookingId   String   @map("booking_id")
  bookingDate String   @map("booking_date") // YYYY-MM-DD
  slotIndex   Int      @map("slot_index") // 0 to 29 (12:00 PM to 10:00 PM)
  podId       String   @default("pod-01") @map("pod_id")
  booking     Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@unique([bookingDate, slotIndex, podId], name: "unique_slot_per_pod")
  @@map("booked_slots")
}

model Holiday {
  id        Int      @id @default(autoincrement())
  date      String   @unique // YYYY-MM-DD
  reason    String?
  createdAt DateTime @default(now()) @map("created_at")

  @@map("holidays")
}

model MenuItem {
  id          Int        @id @default(autoincrement())
  name        String
  category    String     // e.g. "Beverages", "Snacks", "Coffee", "Combos", "Food"
  price       Int        // in INR
  description String?
  isAvailable Boolean    @default(true) @map("is_available")
  createdAt   DateTime   @default(now()) @map("created_at")
  updatedAt   DateTime   @updatedAt @default(now()) @map("updated_at")

  billItems   BillItem[]

  @@map("menu_items")
}

model Bill {
  id             String           @id // e.g. "CC-B-1001"
  customerName   String           @map("customer_name")
  adminId        Int?             @map("admin_id")
  admin          Admin?           @relation(fields: [adminId], references: [id], onDelete: SetNull)
  createdByEmail String?          @map("created_by")

  cashAmount     Int              @default(0) @map("cash_amount")
  onlineAmount   Int              @default(0) @map("online_amount")
  discount       Int              @default(0)
  subtotal       Int              @default(0)
  totalAmount    Int              @map("total_amount")
  paymentStatus  String           @default("paid") @map("payment_status") // paid, partial, pending
  
  ps5Amount      Int              @default(0) @map("ps5_amount")
  cafeAmount     Int              @default(0) @map("cafe_amount")
  customAmount   Int              @default(0) @map("custom_amount")
  notes          String?

  createdAt      DateTime         @default(now()) @map("created_at")
  updatedAt      DateTime         @updatedAt @default(now()) @map("updated_at")

  sessions       BillPs5Session[]
  items          BillItem[]

  @@map("bills")
}

model BillPs5Session {
  id         Int      @id @default(autoincrement())
  billId     String   @map("bill_id")
  controller String   // "single" or "dual"
  duration   Int      // 20, 40, 60 mins
  unitPrice  Int      @map("unit_price") // e.g. 60, 130, 150, 110, 180, 200
  quantity   Int      @default(1)
  total      Int      // unitPrice * quantity

  bill       Bill     @relation(fields: [billId], references: [id], onDelete: Cascade)

  @@map("bill_ps5_sessions")
}

model BillItem {
  id         Int       @id @default(autoincrement())
  billId     String    @map("bill_id")
  menuItemId Int?      @map("menu_item_id")
  name       String    // Snapshot of item name
  price      Int       // Snapshot of unit price
  quantity   Int       @default(1)
  total      Int       // price * quantity
  isCustom   Boolean   @default(false) @map("is_custom")

  bill       Bill      @relation(fields: [billId], references: [id], onDelete: Cascade)
  menuItem   MenuItem? @relation(fields: [menuItemId], references: [id], onDelete: SetNull)

  @@map("bill_items")
}

model Expense {
  id             Int      @id @default(autoincrement())
  title          String
  amount         Int      // in INR
  date           String   // YYYY-MM-DD
  method         String   // "cash" or "online"
  category       String?  // e.g. "Inventory", "Utilities", "Maintenance", "Staff", "Other"
  notes          String?
  adminId        Int?     @map("admin_id")
  admin          Admin?   @relation(fields: [adminId], references: [id], onDelete: SetNull)
  createdByEmail String?  @map("created_by")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @default(now()) @map("updated_at")

  @@map("expenses")
}
